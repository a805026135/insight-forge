<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.insightforge</groupId>
        <artifactId>insightforge</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>insightforge-seckill-core</artifactId>
    <name>InsightForge Seckill Core</name>
    <description>★高并发引擎：Redis Key 规范、Redisson 锁、Kafka 主题（防超卖心脏，M2 扩充）</description>

    <dependencies>
        <dependency>
            <groupId>com.insightforge</groupId>
            <artifactId>insightforge-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Phase 1：秒杀服务需要访问持久层实体与 Mapper -->
        <dependency>
            <groupId>com.insightforge</groupId>
            <artifactId>insightforge-persistence</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>
        <!-- Phase 3：RedisTemplate / StringRedisTemplate（执行 Lua 脚本用）。
             注意：Redis 自动配置在 local profile 下被排除，所以本依赖只会让 Bean 在
             "非 local" profile 出现；local 下 RedisStockService 不会被创建，自动走 DB 兜底。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Phase 5：多级缓存 L1（本地）。直接用 Caffeine API（不依赖 spring-cache 自动配置），
             它的 Cache.get(key, loader) 原生提供「同 key 只有一个线程回源」的原子加载，
             天然防击穿（dogpile）；local profile 下没有 Redis，L1 单独顶着读穿 + 防穿透/雪崩。 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- Phase 4：生产者/消费者用 Jackson 把 OrderCreatedEvent 序列化/反序列化成 JSON。
             这是 Spring Boot 的 JSON starter（web 模块也用它），显式声明以保证 seckill-core
             独立编译时就有 jackson-databind（不依赖 api 模块的 web 依赖传递）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <!-- 测试：JUnit 5 + Mockito（集成缝单测用，如 SalesTickProducerTest 校验 topic/key 一致性） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
