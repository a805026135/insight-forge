# 通用 Worker 构建：用 MODULE 参数指定要打包的模块（agent-core / rule-engine）。
# ⚠️ 沙箱未实跑（无 Docker），仅描述生产构建方式。
# 用法（见 docker-compose.yml 的 build.args.MODULE）：
#   docker build -f deploy/Dockerfile.worker --build-arg MODULE=insightforge-rule-engine -t if-rule-engine insightforge
ARG MODULE=insightforge-agent-core
FROM maven:3.9.9-eclipse-temurin-21 AS build
# 全局 ARG 在 FROM 之后不可见，必须在此重新声明（build-arg 会覆盖默认值）
ARG MODULE
WORKDIR /workspace
COPY . .
RUN --mount=type=cache,target=/root/.m2/repository \
    mkdir -p /root/.m2 && cp maven-settings.xml /root/.m2/settings.xml && \
    mvn -B -pl ${MODULE} -am package -DskipTests

    FROM eclipse-temurin:21-jre
    ARG MODULE
    WORKDIR /app
    COPY --from=build /workspace/${MODULE}/target/${MODULE}-*.jar app.jar
ENTRYPOINT ["java", "-jar", "app.jar"]
