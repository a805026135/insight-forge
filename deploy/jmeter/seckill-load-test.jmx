<?xml version="1.0" encoding="UTF-8"?>
<!--
  InsightForge 秒杀压测计划（Phase 11：JMeter 百万抢购压测）
  ⚠️ 沙箱未执行（无 JMeter / 无运行中的 seckill 服务）。以下为可直接在其本机 JMeter 5.x 打开运行的计划。

  目标：用高并发抢购流量「定量证明」两件事——
    ① 无超卖：压测结束后 SELECT SUM(stock), SUM(sold), MIN(stock) FROM activity_sku
            必须 MIN(stock) >= 0 且 初始库存 - SUM(sold) == SUM(stock)；
    ② exactly-once：重复点击/重投产生的订单数 == 成功扣减次数（见 Phase 4 幂等）。

  「百万级」说明：单机 100 万线程不现实，真实做法是用【分布式 + 多 Loop】逼近：
    - 本计划用 UltimateThreadGroup（或标准 ThreadGroup）按 ramp 渐进加压；
    - 横向扩 slave 节点把并发推到百万级；或用 Loop 把单线程请求数放大。
  压测结束后，用 Phase 6 的 reconcile 脚本（或下方 JDBC 思路）做「最终库存 = 初始 - 已售」对账。
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="InsightForge 秒杀压测" enabled="true">
      <stringProp name="TestPlan.comments">百万抢购压测：验证无超卖 + exactly-once</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="用户定义变量" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.serialize_threadgroups">false</stringProp>
    </TestPlan>
    <hashTree>
      <!-- ===== 渐进加压线程组（代表百万级并发的「压力曲线」） ===== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="秒杀并发用户" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="循环控制器" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">50</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">2000</stringProp>
        <stringProp name="ThreadGroup.ramp_time">300</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <!-- ===== HTTP 抢购请求（POST /api/seckill） ===== -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="抢购请求" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义变量" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="activityId" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">1</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.name">activityId</stringProp>
                <stringProp name="Argument.contentEncoding"></stringProp>
              </elementProp>
              <elementProp name="skuId" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">1</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.name">skuId</stringProp>
                <stringProp name="Argument.contentEncoding"></stringProp>
              </elementProp>
              <elementProp name="userId" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <!-- 每个线程用不同 userId，模拟不同用户抢购（JMeter 内置变量 __threadNum） -->
                <stringProp name="Argument.value">${__threadNum}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.name">userId</stringProp>
                <stringProp name="Argument.contentEncoding"></stringProp>
              </elementProp>
              <elementProp name="qty" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">1</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.name">qty</stringProp>
                <stringProp name="Argument.contentEncoding"></stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/api/seckill</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
        </HTTPSamplerProxy>
        <hashTree/>
        <!-- ===== 响应断言：HTTP 200 且业务不报错 ===== -->
        <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言抢购成功" enabled="true">
          <collectionProp name="Asserion.test_strings">
            <stringProp name="49566">200</stringProp>
          </collectionProp>
          <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
          <boolProp name="Assertion.assume_success">false</boolProp>
          <intProp name="Assertion.test_type">2</intProp>
        </ResponseAssertion>
        <hashTree/>
        <!-- ===== 聚合报告（看吞吐 / 错误率） ===== -->
        <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="聚合报告" enabled="true">
          <boolProp name="ResultCollector.error_logging">false</boolProp>
          <objProp>
            <name>saveConfig</name>
            <value class="SampleSaveConfiguration">
              <boolProp name="xml">false</boolProp>
              <boolProp name="fieldNames">true</boolProp>
              <boolProp name="label">true</boolProp>
              <boolProp name="responseData">false</boolProp>
              <boolProp name="success">true</boolProp>
              <boolProp name="threadName">false</boolProp>
            </value>
          </objProp>
          <stringProp name="filename"></stringProp>
        </ResultCollector>
        <hashTree/>
      </hashTree>
      <!--
        ===== 无超卖对账（压测后人工/脚本执行，不在 JMeter 内跑写库） =====
        思路：在 MySQL 客户端或 CI 后置步骤执行
          SELECT SUM(stock) AS remain, SUM(sold) AS sold, MIN(stock) AS min_stock
          FROM activity_sku WHERE activity_id = 1;
        断言：
          min_stock >= 0                         —— 绝不出现负库存（无超卖）
          (初始库存 - sold) = remain             —— 最终库存 = 初始 - 成功单数（exactly-once / 对账）
        这与 Phase 2 的 SeckillNoOversellTest、Phase 6 的 ReconcileService 是同一套「不超卖」铁证。
      -->
    </hashTree>
  </hashTree>
</jmeterTestPlan>
