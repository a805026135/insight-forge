# 复制为 deploy/.env 并填入真实值（.env 已被 .gitignore 排除，绝不提交）
INSIGHTFORGE_AGENT_DEEPSEEK_ENABLED=true
INSIGHTFORGE_AGENT_DEEPSEEK_API_KEY=sk-your-key-here
INSIGHTFORGE_AGENT_DEEPSEEK_MODEL=deepseek-v4-flash
INSIGHTFORGE_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
# JWT 签名密钥（生产必须换成一个随机强密钥，可用 openssl rand -hex 32 生成）
INSIGHTFORGE_AUTH_JWT_SECRET=change-me-to-a-random-64-char-secret
# Grafana 管理员密码（生产编排必填；请使用独立强密码，不要与 JWT 密钥相同）
GF_SECURITY_ADMIN_PASSWORD=change-me-to-a-strong-grafana-password
# 知识库 embedding（Phase 19）：阿里云百炼 text-embedding-v4；留空则用本地兜底向量
INSIGHTFORGE_AGENT_EMBEDDING_API_KEY=
INSIGHTFORGE_AGENT_EMBEDDING_MODEL=qwen3.7-text-embedding
INSIGHTFORGE_AGENT_VECTORSTORE_TYPE=milvus
